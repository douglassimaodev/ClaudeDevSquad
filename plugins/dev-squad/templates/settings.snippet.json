{
  "extraKnownMarketplaces": {
    "devsys": {
      "source": { "source": "github", "repo": "douglassimaodev/devsys-claude-plugins" }
    }
  },
  "enabledPlugins": {
    "dev-squad@devsys": true
  },
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet format:*)",
      "Bash(npm ci)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npx ng build:*)",
      "Bash(npx ng test:*)",
      "Bash(npx playwright test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Edit(./ProjectInfo/tasks/**)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(dotnet ef database update:*)",
      "Bash(dotnet add:*)",
      "Bash(npm install :*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(./**/appsettings.Production.json)",
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ]
  }
}
