{
  "extraKnownMarketplaces": {
    "dev-squad-marketplace": {
      "source": {
        "source": "github",
        "repo": "douglassimaodev/ClaudeDevSquad"
      }
    }
  },
  "enabledPlugins": {
    "dev-squad@dev-squad-marketplace": true
  },
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet format:*)",
      "Bash(npm ci)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npx ng build:*)",
      "Bash(npx ng test:*)",
      "Bash(npx playwright test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Edit(./ProjectInfo/tasks/**)",
      "Bash(dotnet ef migrations add:*)",
      "Bash(dotnet ef migrations list:*)",
      "Bash(dotnet ef migrations has-pending-model-changes:*)",
      "Bash(dotnet ef database update --connection \"Server=localhost;Port=3306;Database=*_qa_*)",
      "Bash(dotnet run:*)",
      "Bash(* -hlocalhost -uroot -proot -e \"DROP DATABASE IF EXISTS *_qa_*)",
      "Bash(* -hlocalhost -uroot -proot -e \"SHOW *)",
      "Bash(dotnet ef migrations script:*)",
      "Bash(npm start:*)",
      "Bash(npx ng serve:*)",
      "Bash(npm run e2e:*)",
      "Bash(npx playwright --version)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(npm run api:types)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(dotnet ef database update)",
      "Bash(dotnet add:*)",
      "Bash(npm install :*)",
      "Bash(dotnet ef database drop:*)",
      "Bash(npx playwright install:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(./**/appsettings.Production.json)",
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ]
  }
}
